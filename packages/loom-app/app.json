{
  "expo": {
    "name": "Loom",
    "slug": "loom-app",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "loom",
    "icon": "./assets/loom-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/loom-icon.png",
      "bundleIdentifier": "engineering.loom.app",
      "appleTeamId": "CUN3QK592H",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Loom connects to the Loom gateway running on your development machine.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "engineering.loom.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/loom-icon.png"
    }
  }
}
