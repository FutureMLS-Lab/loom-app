{
  "name": "loom-app-monorepo",
  "private": true,
  "scripts": {
    "web": "pnpm --filter loom-app web",
    "gateway": "pnpm --filter loom-app gateway",
    "typecheck": "pnpm --filter loom-app typecheck",
    "web:export": "pnpm --filter loom-app web:export"
  },
  "workspaces": {
    "packages": [
      "packages/loom-app"
    ]
  },
  "pnpm": {
    "overrides": {
      "@expo/dom-webview": "55.0.6",
      "@expo/metro-runtime": "55.0.12",
      "expo-router": "55.0.17",
      "react-native-webview": "13.16.0",
      "react-native-worklets": "0.7.4"
    }
  },
  "packageManager": "pnpm@10.11.0"
}
